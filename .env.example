PEXELS_API_KEY=
LOG_LEVEL=trace # trace, debug, info, warn, error, fatal, silent
WHISPER_VERBOSE=true
PORT=3123
DEV=true # local development mode
DATA_DIR_PATH=

# OpenRouter API for AI script generation
OPENROUTER_API_KEY= # Get from https://openrouter.ai/keys
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet # Default model for script generation

# 2. 데이터베이스 연결 (로컬 Supabase 실행 정보)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 프론트엔드(Client)에서 사용할 이름 (안전을 위해 추가 권장)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
